@startuml
title Рисунок 2.4 – Діаграма варіантів використання системи Voxterra
left to right direction
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 13
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #000000
}
skinparam ArrowColor #000000

actor "Гравець" as Player
actor "Файлова\nсистема\n(config.json)" as FS
actor "GPU\n(Vulkan driver)" as GPU

rectangle "Voxterra" {

  package "Головне меню" {
    usecase "Запустити гру" as UC1
    usecase "Натиснути\n«New Game»" as UC2
    usecase "Натиснути\n«Exit»" as UC3
  }

  package "Ігровий режим" {
    usecase "Переміщати камеру\n(WASD, Space, Shift)" as UC4
    usecase "Оглядатися мишею\n(yaw / pitch)" as UC5
    usecase "Перемкнути\nдебаг-оверлей (F3)" as UC6
    usecase "Поставити гру\nна паузу (Esc)" as UC7
    usecase "Рендерити\nвоксельний світ" as UC8
    usecase "Стримити чанки\nнавколо камери" as UC9
  }

  package "Меню паузи" {
    usecase "Продовжити гру\n(Resume / Esc)" as UC10
    usecase "Повернутись у\nголовне меню" as UC11
  }

  usecase "Завантажити\nконфігурацію" as UC12
}

' Гравець (тільки реалізовані сценарії)
Player --> UC1
Player --> UC2
Player --> UC3
Player --> UC4
Player --> UC5
Player --> UC6
Player --> UC7
Player --> UC10
Player --> UC11

' Системні актори
FS  --> UC12 : читання
GPU <-- UC8  : Vulkan-команди
GPU <-- UC9  : завантаження\nбуферів

' Зв'язки include / extend (відображають фактичну логіку)
UC1 .> UC12 : <<include>>
UC2 .> UC8  : <<include>>
UC2 .> UC9  : <<include>>
UC9 .> UC4  : <<extend>>
UC10 .> UC7 : <<extend>>
UC11 .> UC7 : <<extend>>

note right of UC9
  PlayingState::update щокадрово
  викликає updateStreaming;
  фактичне завантаження чанків —
  при зміні центрального чанка
end note

note bottom of UC6
  Перемикає видимість п'яти
  UILabel у HUD-панелі
end note

note left of UC7
  PausedState::shouldRenderWorld()
  повертає true — світ
  «застигає» під оверлеєм
end note
@enduml
